# ModHarmony English localization.
# Keys follow the tModLoader convention: Mods.ModHarmony.*
# All user-facing text in the mod lives here.

Mods: {
	ModHarmony: {
		Keybind: {
			OpenUI: {
				DisplayName: ModHarmony
			}
		}

		Health: {
			Disclaimer: "Modpack Health is a HEURISTIC, not an objective measurement. It is computed from the issues ModHarmony detected, and nothing else. Click 'Show calculation' to see exactly how the score was derived."
			Explanation: "A high score means 'few detected interactions and no detector failures', not 'this modpack is guaranteed stable'. A low score means 'several risky interactions were detected', not 'this modpack is broken'."
			NoDeductions: "No deductions: nothing flagged on this scan."
			DeductionConflicts: "{0} {1} conflicts with {2} confidence"
			DeductionOverlap: "{0} mods overlap on system '{1}'"
			DeductionLoadOrder: "Load order warning: {0}"
			DeductionDetectorFailure: "{0} detector(s) failed, scan is incomplete"
		}

		Severity: {
			Info: { Name: Informational }
			Low: { Name: Low }
			Medium: { Name: Potential conflict }
			Significant: { Name: Significant conflict }
			High: { Name: High risk }
			Unknown: { Name: Unknown }
		}

		Confidence: {
			Confirmed: { Name: Confirmed }
			Strong: { Name: Strong }
			Possible: { Name: Possible }
			Unknown: { Name: Unknown }
		}

		Detector: {
			Status: {
				Pending: Pending
				Running: Running
				Completed: Completed
				Failed: Failed (skipped, scan continued)
				Disabled: Disabled by configuration
			}
		}

		Detectors: {
			HookOverlap: {
				Name: Hook overlap
				Description: "Flags mods whose Global classes override hooks that run in the same game system (e.g. two mods both override GlobalNPC.AI)."
			}
			GlobalClassOverlap: {
				Name: Global class overlap
				Description: "Informational: mods that register the same kind of Global class (GlobalNPC, GlobalItem, ...), even when they share no specific hook."
			}
			ModPlayerOverlap: {
				Name: ModPlayer overlap
				Description: "Flags mods that attach overlapping behavior to the player through the same ModPlayer hooks."
			}
			ModSystemOverlap: {
				Name: ModSystem overlap
				Description: "Flags mods that register systems with overlapping responsibilities (update loops, world generation, UI layers, recipe phases)."
			}
			RecipeOverlap: {
				Name: Recipe interactions
				Description: "Flags recipes from different mods producing the same item, and recipe groups shared by multiple mods."
			}
			Dependency: {
				Name: Dependency analysis
				Description: "Flags dependency cycles, unmet version requirements and missing optional dependencies."
			}
			ILHooks: {
				Name: IL / runtime patching
				Description: "Finds mods that patch game code at runtime (IL edits / detours) using static, verifiable signals."
			}
			Asset: {
				Name: Asset / resource analysis
				Description: "Finds duplicate mod files and reports what asset conflicts tModLoader itself prevents."
			}
		}

		Evidence: {
			HookOverlap: {
				ModHooks: "{0} overrides hooks on {1}: {2}"
				Aggregate: "{0} mods override hooks on {1} ({2})"
				Why: "Both mods override hooks that run during the same phase for the same entities ({0}). This does NOT prove incompatibility, but it increases the chance that their changes interact."
			}
			GlobalClassOverlap: {
				Pair: "Both mods register {0} classes ({1} and {2}). No specific shared hooks were found."
				Aggregate: "{1} mods register {0} classes. This is informational only."
			}
			ModPlayerOverlap: {
				ModHooks: "{0} overrides player hooks on {1}: {2}"
				Aggregate: "{0} mods override player hooks on {1} ({2})"
				Why: "Both mods attach behavior to the player through the same phase ({0}). Their effects apply to the same player at the same time; this does not prove incompatibility."
			}
			ModSystemOverlap: {
				ModHooks: "{0} overrides system hooks on {1}: {2}"
				Aggregate: "{0} mods override system hooks on {1} ({2})"
				Why: "Both mods register systems that run in the same phase ({0}). Overlapping update loops and UI layers are common and usually harmless; world generation and recipe modification overlap matters more."
			}
			RecipeOverlap: {
				ModRecipes: "{0} registers {2} recipe(s) producing {1}"
				Why: "Multiple mods produce the same item ({0}). This is often intentional (alternate crafting paths). It can matter when the recipes compete for the same ingredients or have very different costs, or when one mod expects to be the only source of the item."
				Aggregate: "{1} mods register recipes producing {0}"
				GroupShared: "A recipe group is shared by {0} mods (tModLoader merges same-name groups). Informational."
			}
			Dependency: {
				Cycle: "Dependency cycle detected: {0}. The load order between these mods is decided by tModLoader heuristics and can change when a mod is updated."
				VersionMismatch: "{0} declares it needs {1} version {2}, but {1} {3} is loaded."
				MissingOptional: "{0} declares an optional dependency on {1}, which is not loaded. Features that depend on {1} are inactive."
			}
			Asset: {
				DuplicateFiles: "Multiple installed files claim the internal name '{0}': {1}. This can confuse updates and mod management."
			}
			ILHooks: {
				SingleMod: "{0} patches game code at runtime (signals: {1}). Patching is a common source of hard-to-diagnose interactions."
				Pair: "{0} and {1} both patch game code at runtime. ModHarmony cannot determine whether they patch the same methods; treat this as a possible interaction only."
			}
		}

		Arbitration: {
			Strategy: {
				Disabled: { Name: Disabled }
				ManualPriority: { Name: Manual priority }
				LoadOrder: { Name: Load order }
				Random: { Name: Random (seeded) }
				WeightedRandom: { Name: Weighted random (seeded) }
				FirstRegistered: { Name: First registered }
				LastRegistered: { Name: Last registered }
			}
			Points: {
				SpawnRate: {
					Name: NPC spawn rate
					Description: "The winning mod's registered factor is applied to NPC spawn rates. Factor < 1 means fewer spawns, > 1 means more; 1 means no change. Only affects mods that register a value via the ModHarmony API."
				}
				NpcDamage: {
					Name: NPC damage taken
					Description: "The winning mod's registered multiplier is applied to damage dealt to NPCs. < 1 means NPCs take less damage, > 1 means more; 1 means no change. Only affects mods that register a value via the ModHarmony API."
				}
			}
		}

		UI: {
			Title: ModHarmony
			Close: X
			Footer: "Session {0} — scan run {1}"
			TabBuildFailed: "This tab could not be built: {0}"
			TabEmpty: "Nothing to show here."
			NoScan: "No scan has run yet. Rescan, or reload mods to scan on startup."

			Tab: {
				Overview: Overview
				Mods: Mods
				Conflicts: Conflicts
				Systems: Systems
				Investigation: Investigation
				Arbitration: Arbitration
				Reports: Reports
				Settings: Settings
			}

			Overview: {
				HealthTitle: Modpack Health
				NoScanYet: "— (no scan)"
				ShowBreakdown: Show calculation
				HideBreakdown: Hide calculation
				StatsTitle: Quick stats
				StatMods: Loaded mods
				StatConflicts: Detected conflicts
				StatHighRisk: High-risk conflicts
				StatSystemsOverlap: Systems with overlap
				StatArbitration: Arbitration groups
				StatDetectorsFailed: Failed detectors
				ChangedTitle: "What changed since your last session?"
				NoChanges: "No differences detected since the last session."
				ChangedAdded: "Added mods: {0}"
				ChangedRemoved: "Removed mods: {0}"
				ChangedVersions: "Version changes: {0}"
				ChangedNewConflicts: "{0} new conflict(s)"
				ChangedResolved: "{0} conflict(s) no longer detected"
				ChangedSeverity: "{0} conflict(s) changed severity"
				ChangedLoadOrder: "{0} load-order change(s)"
				ChangedDependencies: "{0} dependency change(s)"
				ChangedErrors: "{0} new runtime error(s)"
				ActionsTitle: Actions
				Analyze: Analyze Current Situation
				Export: Export Full Report
				CopySummary: Copy Community Summary
				OpenArbitration: Manage Arbitration
				Rescan: Rescan Now
				RescanQueued: "Rescan queued — will run on the next frame."
			}

			Mods: {
				SearchHint: "Search mods..."
				Filter: {
					All: All
					Conflicts: With conflicts
					HighRisk: High risk
					Patchers: Runtime patchers
				}
				NoResults: "No mods match the current search/filter."
				Count: "Showing {0} of {1} mods"
				PatchTag: patches runtime code
				HooksCount: "{0} hooks"
				Back: "< Back"
				NotFound: "Mod not found in the current scan."
				MetaInternalName: Internal name
				MetaVersion: Version
				MetaTMLVersion: Built for tML
				MetaAuthor: Author
				MetaHomepage: Homepage
				MetaSide: Side
				MetaLoadOrder: Load order
				MetaDependencies: Dependencies
				MetaOptional: Optional dependencies
				MetaMissingOptional: Missing optional deps
				MetaVersionExpectation: Version expectation
				MetaSortAfter: Sort after
				MetaSortBefore: Sort before
				MetaCodeUnavailable: Assembly not inspectable
				Yes: yes
				No: no
				HooksTitle: "Detected hooks ({0}) by game system"
				NoHooks: "No hook overrides detected (the mod may still register content or patch code)."
				ContentTitle: Registered content
				ConflictsTitle: "Conflicts involving this mod ({0})"
				NoConflicts: "No conflicts detected for this mod."
				DetailStatus: "Mod details — {0}"
			}

			Conflicts: {
				SearchHint: "Search conflicts..."
				Sev: {
					All: Severity: all
					High: High
					Significant: Significant
					Medium: Medium
					Low: Low
					Info: Info
				}
				Conf: {
					All: Confidence: all
					Confirmed: Confirmed
					Strong: Strong
					Possible: Possible
					Unknown: Unknown
				}
				Res: {
					All: Resolution: all
					Resolvable: Resolvable
					Unresolvable: Unresolvable
				}
				ShowMuted: Show muted
				HideMuted: Hide muted
				Count: "Showing {0} of {1} conflicts"
				NoResults: "No conflicts match the current filters."
				WhyHeader: "Why is this here?"
				ArbitrationActive: "Arbitration: {0} — winner: {1}"
				ArbitrationUnavailable: "Status: Detection available — automatic resolution unavailable."
				Mute: Mute
				Unmute: Unmute
				Why: {
					HookOverlap: "Both mods override hooks that run in the same phase for the same entities. This does not prove incompatibility, but it increases the chance that their changes interact."
					GlobalClassOverlap: "Both mods add global behavior to the same entity type. Informational — registering globals is a normal and expected part of modding."
					ModPlayerOverlap: "Both mods attach behavior to the player in the same phase. Their effects apply to the same player at the same time."
					ModSystemOverlap: "Both mods run systems in the same phase. This is common and usually harmless; the severity reflects how likely the overlap is to matter."
					RecipeOverlap: "Both mods register recipes for the same result. Often intentional; can matter when recipes compete for ingredients."
					Dependency: "The dependency graph of your modpack has an unusual property that can affect load order and feature availability."
					ILHooks: "At least one of these mods patches game code at runtime. Runtime patches are a common source of hard-to-diagnose interactions."
					Asset: "Installed files collide or duplicate each other."
				}
			}

			Systems: {
				Explanation: "Game systems are the central vocabulary of ModHarmony. Below are the systems that at least two mods interact with. Click a system to see which mods touch it, which conflicts exist on it, and whether ModHarmony can arbitrate it."
				Count: "{0} systems with overlap"
				ModsCount: "{0} mods"
				ModsTitle: "Mods touching this system ({0})"
				NoMods: "No mods are currently detected on this system."
				ConflictsTitle: "Conflicts on this system ({0})"
				NoConflicts: "No conflicts on this system."
				ArbitrationTitle: Arbitration
				ArbitrationAvailable: "A ModHarmony arbitration point exists for this system. Open the Arbitration tab to configure it."
				ArbitrationUnavailable: "Detection available — automatic resolution unavailable. ModHarmony has no technically safe mechanism to arbitrate this system."
			}

			Investigation: {
				ActiveTitle: "Investigation Mode is ACTIVE"
				InactiveTitle: "Investigation Mode is off"
				Explanation: "Investigation Mode collects safe runtime diagnostics while you play: exceptions whose stack traces involve loaded mods, and frame-time sampling. It adds a small performance cost while active, so it is off by default. Enable it when you are chasing a bug."
				Enable: Enable Investigation Mode
				Disable: Disable Investigation Mode
				Clear: Clear captured events
				Analyze: Analyze Current Situation
				ShowStacks: Show stack traces
				HideStacks: Hide stack traces
				PerformanceTitle: Performance sampling
				PerformanceSummary: "Current: {0}"
				PerformanceCaveat: "Frame-time sampling measures ModHarmony's view of frame pacing only. It cannot attribute a slowdown to a specific mod."
				EventsTitle: "Captured runtime events ({0})"
				NoEvents: "No exceptions involving loaded mods have been captured yet."
				NoModAttribution: "(no mod attribution)"
				InvolvedMods: "Likely involved mods: {0}"
				PreviewTitle: Report preview
				Export: Export report to file
				Status: "{0} events, {1} frame spikes"
			}

			Arbitration: {
				EnabledTitle: "Arbitration is ENABLED"
				DisabledTitle: "Arbitration is disabled"
				Explanation: "Arbitration lets you decide which mod 'wins' when several mods compete over a supported system. It is strictly opt-in: detection runs always, but nothing is applied until you enable arbitration and choose a strategy."
				SafetyNote: "ModHarmony only arbitrates systems with a technically safe mechanism, and only affects mods that opt in through the ModHarmony API. It never injects into or patches other mods' code."
				NoGroups: "No arbitration groups exist yet. Groups appear when conflicts are detected on arbitrable systems."
				ResolvableTitle: "Resolvable systems"
				DetectionOnlyTitle: "Detection-only systems ({0})"
				DetectionOnlyNote: "These systems have detected interactions but no technically safe arbitration mechanism. ModHarmony will never attempt unsafe hacks to force a resolution."
				Unavailable: "Detection available — automatic resolution unavailable."
				Status: "{0} arbitration groups"
				Strategy: "Strategy: {0} (click to change)"
				Winner: "Current winner: {0}"
				NoWinner: "No winner (disabled, no candidates, or no mechanism)."
				Priority: "priority {0}"
				Weight: "weight {0}"
				Seed: "Seed: {0}"
				SeedAuto: "auto (deterministic from master seed)"
				Regenerate: Regenerate Selection
				Lock: Lock Current Decision
				Unlock: Unlock
				StabilityNote: "Random and weighted decisions use a controlled, seeded RNG. They are resolved once, stay stable until you regenerate or unlock, and are persisted across sessions."
			}

			Reports: {
				Title: Reports & export
				Explanation: "The full report is written to {Main.SavePath}/ModHarmony/reports/ as a text file you can open in any editor. The community summary is a compact block designed to paste into a Discord or GitHub issue."
				ExportFull: Export Full Report
				CopySummary: Copy Community Summary
				PreviewTitle: Report preview
				NoPreview: "No report generated yet — click Export Full Report to preview and save one."
				ExportedTo: "Report saved to: {0}"
				Copied: "Community summary copied to clipboard."
			}

			Settings: {
				Title: Settings
				ConfigHint: "Full settings live in the tModLoader config UI. Below is a summary of the current state and detector health."
				OpenConfig: Open ModHarmony Config
				CurrentTitle: Current configuration
				Enabled: ModHarmony enabled
				SafeMode: Safe Diagnostics Mode
				Arbitration: Arbitration active
				DefaultStrategy: Default strategy
				RuntimeMonitoring: Runtime monitoring
				InvestigationActive: Investigation Mode active
				DeveloperMode: Developer Mode
				DetectorsTitle: Detector health
				NoScanYet: "No scan has run yet."
				PathsTitle: Paths
				PathSave: Save path
				PathMods: Mods folder
				PathData: ModHarmony data
			}
		}

		Systems: {
			item_use: { Name: Item use behavior, Description: "How items are used: use time, mana, ammo, shooting, right-click." }
			item_damage: { Name: Item damage, Description: "Weapon damage, knockback and crit modification through items." }
			item_tooltip: { Name: Item tooltips, Description: "Tooltip text and drawing." }
			item_inventory: { Name: Item inventory behavior, Description: "Equip effects, inventory updates, pickup and stacking." }
			item_draw: { Name: Item drawing, Description: "In-world and in-inventory item rendering." }
			item_loot: { Name: Item loot, Description: "Loot tables attached to items." }
			item_modification: { Name: Item global modification, Description: "Other GlobalItem behavior not covered by a more specific system." }
			npc_ai: { Name: NPC AI, Description: "NPC thinking, movement and behavior." }
			npc_damage: { Name: NPC damage, Description: "Damage dealt to and by NPCs." }
			npc_spawn: { Name: NPC spawning, Description: "Spawn rates, ranges and pools." }
			npc_loot: { Name: NPC loot, Description: "Drops and loot tables." }
			npc_stats: { Name: NPC stats, Description: "Life, defense, scaling, kill handling." }
			npc_shop: { Name: NPC shops, Description: "Shop contents and prices." }
			npc_chat: { Name: NPC chat, Description: "Dialogue and chat buttons." }
			npc_draw: { Name: NPC drawing, Description: "Rendering of NPCs." }
			npc_collision: { Name: NPC collision, Description: "Hitbox and collision behavior." }
			npc_modification: { Name: NPC global modification, Description: "Other GlobalNPC behavior not covered by a more specific system." }
			projectile_ai: { Name: Projectile AI, Description: "Projectile movement and behavior." }
			projectile_damage: { Name: Projectile damage, Description: "Damage dealt by projectiles." }
			projectile_collision: { Name: Projectile collision, Description: "Tiles/entity collision and cutting." }
			projectile_draw: { Name: Projectile drawing, Description: "Rendering of projectiles." }
			projectile_modification: { Name: Projectile global modification, Description: "Other GlobalProjectile behavior." }
			player_update: { Name: Player update, Description: "Per-frame player logic: movement, buffs, equipment updates." }
			player_stats: { Name: Player stats, Description: "Max stats, life regen, luck, fishing, nurse prices." }
			player_damage: { Name: Player damage, Description: "Damage taken and dealt by the player, dodges, death." }
			player_inventory: { Name: Player inventory, Description: "Inventory interactions, buying/selling, starting items." }
			player_save: { Name: Player save data, Description: "Custom player save/load and client sync." }
			player_draw: { Name: Player drawing, Description: "Player rendering and draw layers." }
			player_lifecycle: { Name: Player lifecycle, Description: "Connect, enter world, respawn events." }
			buff_update: { Name: Buff behavior, Description: "Buff application and per-tick effects." }
			buff_tooltip: { Name: Buff tooltips, Description: "Buff display text." }
			buff_draw: { Name: Buff drawing, Description: "Buff icon rendering." }
			tile_modification: { Name: Tile behavior, Description: "Tile drops, activation, conversion." }
			tile_draw: { Name: Tile drawing, Description: "Tile rendering and animation." }
			tile_wire: { Name: Wire logic, Description: "Wire, switch and actuator behavior." }
			recipe_add: { Name: Recipe additions, Description: "Recipes added during load." }
			recipe_modify: { Name: Recipe modification, Description: "Post-processing of other mods' recipes." }
			recipe_remove: { Name: Recipe removal, Description: "Recipes being hidden/disabled." }
			recipe_group: { Name: Recipe groups, Description: "Groups of interchangeable items in recipes." }
			world_gen: { Name: World generation, Description: "World structure generation passes." }
			world_update: { Name: World update, Description: "Per-frame world logic and invasions." }
			world_save: { Name: World save data, Description: "Custom world save/load." }
			world_time: { Name: Time & event rates, Description: "Day/night speed and event rates." }
			world_lifecycle: { Name: World lifecycle, Description: "World load/unload events." }
			ui_layers: { Name: UI layers, Description: "Interface layers and game tips." }
			ui_update: { Name: UI update, Description: "Per-frame UI update hooks." }
			ui_input: { Name: Input handling, Description: "Post-input hooks and keybind processing." }
			rendering_draw: { Name: Rendering, Description: "Screen position, transform and post-draw hooks." }
			net_packets: { Name: Network packets, Description: "Custom packet send/receive." }
			net_hijack: { Name: Network hijacking, Description: "Intercepting vanilla net messages." }
			dependency_cycle: { Name: Dependency cycle, Description: "Mods depending on each other in a loop." }
			dependency_version: { Name: Version requirement, Description: "A mod requires a specific version of another mod." }
			dependency_missing: { Name: Missing dependency, Description: "A required mod is absent (cannot load)." }
			dependency_optional: { Name: Optional dependency, Description: "A declared optional dependency is not loaded." }
			runtime_patch: { Name: Runtime patching, Description: "IL edits and detours of game code." }
			runtime_errors: { Name: Runtime errors, Description: "Exceptions observed while playing." }
			asset_duplicate: { Name: Duplicate resources, Description: "Installed files claiming the same identity." }
			content_globalItem: { Name: GlobalItem registration, Description: "Mods adding GlobalItem behavior." }
			content_globalNPC: { Name: GlobalNPC registration, Description: "Mods adding GlobalNPC behavior." }
			content_globalProjectile: { Name: GlobalProjectile registration, Description: "Mods adding GlobalProjectile behavior." }
			content_globalBuff: { Name: GlobalBuff registration, Description: "Mods adding GlobalBuff behavior." }
			content_globalTile: { Name: GlobalTile registration, Description: "Mods adding GlobalTile behavior." }
			content_globalWall: { Name: GlobalWall registration, Description: "Mods adding GlobalWall behavior." }
			content_modPlayer: { Name: ModPlayer registration, Description: "Mods adding player systems." }
			content_modSystem: { Name: ModSystem registration, Description: "Mods adding global systems." }
			content_load: { Name: Load lifecycle, Description: "OnModLoad/PostSetupContent hooks." }
		}

		Report: {
			Title: "ModHarmony Compatibility Report"
			Generated: "Generated: {0}"
			GameVersions: "Terraria: {0} — tModLoader: {1}"
			Session: "Session: {0}"
			SectionMods: "LOADED MODS ({0})"
			Dependencies: "dependencies: {0}"
			WeakDependencies: "optional dependencies: {0}"
			MissingOptional: "missing optional dependencies: {0}"
			Hooks: "hook overrides: {0} (systems: {1})"
			Content: "content: {0}"
			PatchSignals: "runtime patching signals: {0}"
			CodeUnavailable: "(assembly could not be inspected)"
			SectionConflicts: "DETECTED CONFLICTS ({0})"
			NoConflicts: "No conflicts were detected."
			ConflictSystem: "system: {0} (detector {1}, id {2})"
			ArbitrationResolvable: "arbitration: {0} — winner: {1}"
			ArbitrationUnavailable: "arbitration: Detection available — automatic resolution unavailable."
			ConflictsTruncated: "(... {0} more conflicts omitted from this export)"
			SectionSystems: "SYSTEMS WITH MOST OVERLAP"
			ModsTouching: "mod(s)"
			SectionArbitration: "ARBITRATION GROUPS ({0})"
			ArbitrationResolved: "resolved — winner: {0}"
			SectionRuntime: "RUNTIME DIAGNOSTICS"
			NoRuntimeEvents: "No runtime events captured (Investigation Mode was off or nothing was captured)."
			NoModAttribution: "no mod attribution"
			InvolvedMods: "likely involved mods: {0}"
			EventsTruncated: "(... {0} more events omitted)"
			Performance: "frame pacing: {0}"
			DetectorFailures: "{0} detector(s) failed during the scan:"
			SectionHealth: "MODPACK HEALTH: {0}/100 (heuristic)"
			SectionRecommendations: "RECOMMENDED INVESTIGATION"
			NoHighRisk: "No high-risk interactions detected — if you are experiencing a bug, enable Investigation Mode and reproduce it, then export a new report."
			HighRiskRecommendation: "{0} high-risk interaction(s) detected. The most likely candidates to investigate:"
			ILRecommendation: "Mods using runtime patching: {0}. If a bug appears suddenly, try disabling these one at a time."
			GoodHealth: "This pack shows few detected interactions. Remember: detection is limited to what tModLoader exposes."
			BadHealth: "This pack has several detected interactions. Disable mods one at a time, starting with the highest-risk pairs, and check whether the issue disappears."
			Footer: "— ModHarmony: detect, explain, investigate, suggest. It does not pretend every interaction is a bug, and it never modifies other mods' code."
			InvestigationTitle: "ModHarmony — Analyze Current Situation"
			InvestigationContext: "world: {1} — mode: {2} — save path: {0}"
			ModeServer: "server"
			ModeClient: "client"
			InvestigationMods: "LOADED MODS: {0}"
			ErrorCount: "{0} error(s)"
			InvestigationTopMods: "Mods appearing most in captured errors: {0}"
			InvestigationSteps: "RECOMMENDED STEPS"
			Step1: "Disable the mods listed under 'Likely involved mods', one at a time, reproducing the bug after each change."
			Step2: "For high-risk conflict pairs, try changing the load order or disabling one member of the pair."
			Step3: "If the error mentions a mod that uses runtime patching, that mod is a strong candidate — check for known issues or a newer version."
			Step4: "Attach this report (or the community summary) when asking for help, so helpers see your exact mod list and versions."
			CommunityTitle: "ModHarmony Diagnostic Summary"
			CommunityMods: "Mods ({0}):"
			CommunityConflicts: "High-risk interactions ({0}):"
			CommunityErrors: "Runtime errors ({0}):"
			CommunitySystems: "Relevant systems:"
			CommunityFooter: "— generated by ModHarmony (detect → explain → investigate → suggest)"
		}
	}
}

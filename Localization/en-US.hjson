# ModHarmony English localization.
# All user-facing text lives here. Keys are stable; values are plain language.

Mods: {
	ModHarmony: {
		Keybinds: {
			OpenUI: {
				DisplayName: ModHarmony
			}
		}

		Health: {
			Disclaimer: "This score is a rough guide, not a measurement. It is based only on what ModHarmony detected, and you can see exactly how it was calculated below."
			Explanation: "A high score means: few detected interactions. A low score means: several risky interactions were found. Either way, check the red and orange items first."
			NoDeductions: "Nothing was flagged on this scan."
			DeductionConflicts: "{0} {1} conflicts ({2} confidence)"
			DeductionOverlap: "{0} mods touch the same system: {1}"
			DeductionLoadOrder: "Load order warning: {0}"
			DeductionDetectorFailure: "{0} scanner(s) failed, so this scan is incomplete"
			Good: "Looking good!"
			Ok: "A few things to check."
			Bad: "Several things to investigate."
		}

		Severity: {
			Info: { Name: "Informational" }
			Low: { Name: "Low" }
			Medium: { Name: "Watch out" }
			Significant: { Name: "Concerning" }
			High: { Name: "High risk" }
			Unknown: { Name: "Unknown" }
		}

		Confidence: {
			Confirmed: { Name: "Confirmed" }
			Strong: { Name: "Strong" }
			Possible: { Name: "Possible" }
			Unknown: { Name: "Unknown" }
		}

		Detector: {
			Status: {
				Pending: Pending
				Running: Running
				Completed: Done
				Failed: Failed (other scans continued)
				Disabled: Off
			}
		}

		Detectors: {
			HookOverlap: {
				Name: Mods touching the same thing
				Description: "Finds mods that both change the same part of the game (like NPC behavior)."
			}
			GlobalClassOverlap: {
				Name: Mods adding similar add-ons
				Description: "Notes when mods both add the same kind of extension to the game."
			}
			ModPlayerOverlap: {
				Name: Mods changing the player
				Description: "Finds mods that both change the player in the same way."
			}
			ModSystemOverlap: {
				Name: Mods running the same systems
				Description: "Finds mods that both run background systems (world gen, UI, recipes)."
			}
			RecipeOverlap: {
				Name: Recipe overlaps
				Description: "Finds mods that craft the same item, and recipe groups shared by mods."
			}
			Dependency: {
				Name: Dependency check
				Description: "Checks mod dependencies: cycles and missing optional mods."
			}
			ILHooks: {
				Name: Deep code changes
				Description: "Finds mods that change the game's code directly at runtime."
			}
			Asset: {
				Name: File conflicts
				Description: "Finds duplicate mod files that could confuse updates."
			}
		}

		Evidence: {
			HookOverlap: {
				ModHooks: "{0} changes {1} (hooks: {2})"
				Aggregate: "{0} mods all change {1} ({2})"
				Why: "Both mods change the same part of the game. That alone does not break anything, but it raises the chance their changes clash."
			}
			GlobalClassOverlap: {
				Pair: "Both mods add {0} extensions ({1} and {2}). This is normal and usually harmless."
				Aggregate: "{1} mods add {0} extensions. Nothing to worry about on its own."
			}
			ModPlayerOverlap: {
				ModHooks: "{0} changes the player via {1} (hooks: {2})"
				Aggregate: "{0} mods change the player via {1} ({2})"
				Why: "Both mods change the player at the same moment. Their effects can add up or clash."
			}
			ModSystemOverlap: {
				ModHooks: "{0} runs system hooks on {1} (hooks: {2})"
				Aggregate: "{0} mods run system hooks on {1} ({2})"
				Why: "Both mods run background systems in the same phase. Usually fine; world gen and recipe edits matter most."
			}
			RecipeOverlap: {
				ModRecipes: "{0} adds {2} recipe(s) for {1}"
				Why: "Several mods craft the same item. That is often intentional (alternate ways to craft). It only matters when they fight over the same materials."
				Aggregate: "{1} mods add recipes for {0}"
				GroupShared: "A recipe group is shared by {0} mods. Informational."
			}
			Dependency: {
				Cycle: "These mods depend on each other in a circle: {0}. Their load order is decided automatically and can change when a mod updates."
				MissingOptional: "{0} can optionally use {1}, which is not installed. Features needing {1} are simply off."
			}
			Asset: {
				DuplicateFiles: "Several installed files claim the name '{0}': {1}. Old copies can confuse updates — consider removing the extra ones."
			}
			ILHooks: {
				SingleMod: "{0} changes game code directly at runtime (signals: {1}). This kind of mod can clash with others in hard-to-see ways."
				Pair: "{0} and {1} both change game code at runtime. They may or may not touch the same place — treat this as a possible clash only."
			}
		}

		Arbitration: {
			Strategy: {
				Disabled: { Name: "Disabled" }
				ManualPriority: { Name: "Manual priority" }
				LoadOrder: { Name: "Load order" }
				Random: { Name: "Random (seeded)" }
				WeightedRandom: { Name: "Weighted random (seeded)" }
				FirstRegistered: { Name: "First registered" }
				LastRegistered: { Name: "Last registered" }
			}
			Points: {
				SpawnRate: {
					Name: NPC spawn rate
					Description: "The winning mod's setting is applied to how often enemies spawn. Only affects mods that opt in."
				}
				NpcDamage: {
					Name: Damage to enemies
					Description: "The winning mod's setting is applied to how much damage enemies take. Only affects mods that opt in."
				}
			}
		}

		UI: {
			Title: ModHarmony
			Close: X
			Footer: "Session {0} — scan run {1}"
			TabBuildFailed: "This tab could not be built: {0}"
			TabEmpty: "Nothing to show here."
			NoScan: "No scan yet. Click Rescan below, or reload your mods."

			Tab: {
				Overview: Overview
				Mods: Mods
				Conflicts: Conflicts
				Systems: Systems
				Investigation: Investigate
				Arbitration: Arbitration
				Reports: Reports
				Settings: Settings
			}

			Overview: {
				HealthTitle: Modpack Health
				NoScanYet: "— (no scan)"
				ShowBreakdown: Show how this is calculated
				HideBreakdown: Hide calculation
				StatsTitle: At a glance
				StatMods: Loaded mods
				StatConflicts: Things flagged
				StatHighRisk: Worth your attention
				StatSystemsOverlap: Systems with several mods
				StatArbitration: Arbitration groups
				StatDetectorsFailed: Failed scanners
				AttentionTitle: "Things that need your attention:"
				AttentionNone: "Nothing urgent. If you are seeing a bug anyway, try the Investigate tab."
				AttentionCount: "{0} item(s) flagged red or orange. Start with the Conflicts tab."
				StartHereTitle: "New here? Start with this:"
				StartHere1: "1. Open the Conflicts tab — the red and orange items are the ones to look at first."
				StartHere2: "2. If you are chasing a bug, turn on Investigation Mode (Investigate tab), reproduce it, then click Analyze."
				StartHere3: "3. Still stuck? Export a report (Reports tab) and share it when asking for help."
				ChangedTitle: "What changed since your last session?"
				NoChanges: "Nothing changed since the last session."
				ChangedAdded: "Added: {0}"
				ChangedRemoved: "Removed: {0}"
				ChangedVersions: "Updated: {0}"
				ChangedNewConflicts: "{0} new flag(s)"
				ChangedResolved: "{0} flag(s) gone"
				ChangedSeverity: "{0} flag(s) changed severity"
				ChangedLoadOrder: "{0} load order change(s)"
				ChangedDependencies: "{0} dependency change(s)"
				ChangedErrors: "{0} new runtime error(s)"
				ActionsTitle: Quick actions
				Analyze: Analyze Current Situation
				Export: Save Full Report
				SaveSummary: Save Short Summary
				OpenArbitration: Manage Arbitration
				Rescan: Scan Again
				RescanQueued: "Scan will run on the next frame."
			}

			Mods: {
				SearchHint: "Search mods..."
				Filter: {
					All: All
					Conflicts: Flagged
					HighRisk: Red / orange
					Patchers: Deep code changes
				}
				NoResults: "No mods match."
				Count: "Showing {0} of {1} mods"
				PatchTag: "changes game code"
				HooksCount: "{0} hooks"
				Back: "< Back"
				NotFound: "Mod not found in the current scan."
				MetaInternalName: Internal name
				MetaVersion: Version
				MetaTMLVersion: Built for tML
				MetaAuthor: Author
				MetaHomepage: Homepage
				MetaSide: Side
				MetaLoadOrder: Load order
				MetaDependencies: Dependencies
				MetaOptional: Optional dependencies
				MetaMissingOptional: Missing optional deps
				MetaVersionExpectation: Version expectation
				MetaSortAfter: Sort after
				MetaSortBefore: Sort before
				MetaCodeUnavailable: Assembly not readable
				Yes: yes
				No: no
				HooksTitle: "What this mod changes ({0} hooks)"
				NoHooks: "No direct hooks found (it may still add content or change game code)."
				ContentTitle: What this mod adds
				ConflictsTitle: "Flags involving this mod ({0})"
				NoConflicts: "No flags for this mod."
				DetailStatus: "Mod details — {0}"
			}

			Conflicts: {
				SearchHint: "Search..."
				Sev: {
					All: Severity: all
					High: High risk
					Significant: Concerning
					Medium: Watch out
					Low: Low
					Info: Info
				}
				Conf: {
					All: Certainty: all
					Confirmed: Confirmed
					Strong: Strong
					Possible: Possible
					Unknown: Unknown
				}
				Res: {
					All: Fixable: all
					Resolvable: Fixable
					Unresolvable: Not fixable
				}
				ShowMuted: Show hidden
				HideMuted: Hide hidden
				Count: "Showing {0} of {1}"
				NoResults: "Nothing matches these filters."
				IncludeQuiet: Include low/info items
				HideQuiet: Hide low/info items
				WhyHeader: "Why was this flagged?"
				Details: Technical details
				HideDetails: Hide technical details
				ActionTitle: "What you can do:"
				ArbitrationActive: "Arbitration: {0} — winner: {1}"
				ArbitrationUnavailable: "Detection only — ModHarmony cannot safely auto-fix this."
				Mute: Hide this
				Unmute: Show again
				Summary: {
					HookOverlap: "Both mods change the same part of the game."
					GlobalClassOverlap: "Both mods add the same kind of extension."
					ModPlayerOverlap: "Both mods change the player in the same way."
					ModSystemOverlap: "Both mods run background systems in the same phase."
					RecipeOverlap: "Both mods craft the same item."
					Dependency: "There is something unusual in how these mods depend on each other."
					ILHooks: "One or both mods change game code directly."
					Asset: "Installed mod files collide or duplicate."
				}
				Action: {
					HookOverlap: "If you see bugs with this part of the game, disable one of these mods and test again. That tells you which one is responsible."
					GlobalClassOverlap: "Nothing to do. This is normal modding behavior."
					ModPlayerOverlap: "If the bug involves your character, try disabling one of these mods."
					ModSystemOverlap: "If world gen or UI looks wrong, try disabling one of these mods."
					RecipeOverlap: "Usually nothing to do. If an item is missing from crafting, check these mods."
					Dependency: "Nothing urgent. Update the mods involved if you see errors about them."
					ILHooks: "This is the most likely source of weird bugs. Try disabling these mods one at a time."
					Asset: "Remove the duplicate files listed above, then reload mods."
				}
				Why: {
					HookOverlap: "Both mods change the same part of the game. That raises the chance their changes clash, but it is not proof of a bug."
					GlobalClassOverlap: "Both mods add extensions to the same entity type. Normal and expected."
					ModPlayerOverlap: "Both mods change the player at the same time. Effects can add up or clash."
					ModSystemOverlap: "Both mods run systems in the same phase. Usually harmless."
					RecipeOverlap: "Both mods register recipes for the same item. Often intentional."
					Dependency: "The mods' dependency graph has an unusual property."
					ILHooks: "Runtime code changes are a common source of hard-to-explain bugs."
					Asset: "Installed files claim the same identity."
				}
			}

			Systems: {
				Explanation: "These are the parts of the game that several of your mods touch. Click one to see which mods are involved and whether ModHarmony can help."
				Count: "{0} systems with several mods"
				ModsCount: "{0} mods"
				ModsTitle: "Mods touching this ({0})"
				NoMods: "No mods detected here."
				ConflictsTitle: "Flags on this system ({0})"
				NoConflicts: "No flags here."
				ArbitrationTitle: Arbitration
				ArbitrationAvailable: "ModHarmony can arbitrate this. Open the Arbitration tab to set it up."
				ArbitrationUnavailable: "ModHarmony can see this but cannot auto-fix it safely."
			}

			Investigation: {
				ActiveTitle: "Investigation Mode is ON"
				InactiveTitle: "Investigation Mode is off"
				Explanation: "Use this when a bug is bothering you. While on, ModHarmony watches for errors linked to your mods and tracks slow frames. It costs a little performance, so it is off by default."
				Enable: Turn on Investigation Mode
				Disable: Turn off Investigation Mode
				Clear: Clear captured data
				Analyze: Analyze Current Situation
				ShowStacks: Show error details
				HideStacks: Hide error details
				PerformanceTitle: Performance
				PerformanceSummary: "Current: {0}"
				PerformanceCaveat: "This is only an estimate of frame pacing — it cannot say which mod is slow."
				EventsTitle: "Errors captured ({0})"
				NoEvents: "No mod-related errors captured yet."
				NoModAttribution: "(no mod linked)"
				InvolvedMods: "Mods that may be involved: {0}"
				PreviewTitle: Report preview
				Export: Save report to file
				Status: "{0} errors, {1} slow frames"
			}

			Arbitration: {
				EnabledTitle: "Arbitration is ON"
				DisabledTitle: "Arbitration is off"
				Explanation: "When several mods fight over the same setting, you can pick who wins. It is off by default — nothing changes until you turn it on and choose a strategy."
				SafetyNote: "ModHarmony only arbitrates systems it can do safely, and only affects mods that opt in. It never patches other mods."
				NoGroups: "No arbitration groups yet. They appear when conflicts are found on fixable systems."
				ResolvableTitle: "Systems you can control"
				DetectionOnlyTitle: "Seen but not fixable ({0})"
				DetectionOnlyNote: "ModHarmony can see these interactions but has no safe way to change the outcome."
				Unavailable: "Seen, but not fixable."
				Status: "{0} arbitration groups"
				Strategy: "Strategy: {0} (click to change)"
				Winner: "Winner: {0}"
				NoWinner: "No winner yet."
				Priority: "priority {0}"
				Weight: "weight {0} (~{1}% chance)"
				Seed: "Seed: {0}"
				SeedAuto: "auto (stable until changed)"
				Regenerate: Roll Again
				Lock: Lock This Choice
				Unlock: Unlock
				StabilityNote: "Random choices use a fixed seed: they are decided once and stay stable until you roll again."
			}

			Reports: {
				Title: Reports
				Explanation: "Save a full report to a text file, or save a short summary you can paste when asking for help. Everything is saved on your computer — no internet needed."
				ExportFull: Save Full Report
				SaveSummary: Save Short Summary
				PreviewTitle: Preview
				NoPreview: "Nothing generated yet — click Save Full Report."
				ExportedTo: "Saved to: {0}"
				SavedTo: "Saved to: {0}"
			}

			Settings: {
				Title: Settings
				ConfigHint: "Full settings are in the tModLoader config screen (Mods → ModHarmony → gear icon). Below is the current state."
				OpenConfig: Open ModHarmony Config

# ModHarmony config localization.
# The prefix "Mods.ModHarmony.Configs" is assumed for all keys in this file.

Headers: {
	General: General
	Scanning: Scanning
	Performance: Performance
	Arbitration: Arbitration
	UI: UI
}

ModHarmonyConfig: {
	DisplayName: ModHarmony

	EnableModHarmony: {
		Label: Enable ModHarmony
		Tooltip: "Master switch. Turn off to stop all scanning."
	}

	EnableDiagnostics: {
		Label: Enable diagnostics
		Tooltip: "Lets ModHarmony collect diagnostic information."
	}

	RunStartupScan: {
		Label: Scan on load
		Tooltip: "Scan your mods every time the game loads mods."
	}

	RuntimeMonitoring: {
		Label: Investigation Mode
		Tooltip: "Watch for errors and slow frames while you play. Use when troubleshooting."
	}

	LogLevel: {
		Label: Log level
		Tooltip: "How much ModHarmony writes to the game log."
	}

	SafeDiagnosticsMode: {
		Label: Safe Diagnostics Mode
		Tooltip: "Detect and explain only. Never changes anything. Recommended."
	}

	ScanHooks: {
		Label: Scan hook overlap
		Tooltip: "Find mods that change the same part of the game."
	}

	ScanGlobalClasses: {
		Label: Scan global classes
		Tooltip: "Find mods adding the same kind of extensions."
	}

	ScanRecipes: {
		Label: Scan recipes
		Tooltip: "Find mods crafting the same items and shared recipe groups."
	}

	ScanAssets: {
		Label: Scan assets
		Tooltip: "Find duplicate mod files that confuse updates."
	}

	ScanDependencies: {
		Label: Scan dependencies
		Tooltip: "Check dependency cycles and missing optional mods."
	}

	ScanILHooks: {
		Label: Scan deep code changes
		Tooltip: "Find mods that change game code directly at runtime."
	}

	MaxRetainedEvents: {
		Label: Max captured events
		Tooltip: "How many errors Investigation Mode keeps in memory."
	}

	FrameSpikeThresholdMs: {
		Label: Slow frame threshold (ms)
		Tooltip: "Frames slower than this are counted as slow."
	}

	EnableArbitration: {
		Label: Enable arbitration
		Tooltip: "Allow choosing which mod wins when several fight over a setting. Off by default."
	}

	DefaultStrategy: {
		Label: Default strategy
		Tooltip: "Strategy used for new arbitration groups."
	}

	RandomSeed: {
		Label: Master random seed
		Tooltip: "Seed for random arbitration. Change it to get a different stable result."
	}

	PersistDecisions: {
		Label: Persist decisions
		Tooltip: "Remember arbitration choices between sessions."
	}

	ShowInformational: {
		Label: Show informational items
		Tooltip: "Show harmless informational flags in the Conflicts tab."
	}

	ShowLowRisk: {
		Label: Show low-risk items
		Tooltip: "Show low-risk flags in the Conflicts tab."
	}

	DeveloperMode: {
		Label: Developer Mode
		Tooltip: "Show raw technical details (type names, ids, raw evidence)."
	}

	CompactMode: {
		Label: Compact mode
		Tooltip: "Show more entries on screen with tighter spacing."
	}
}
